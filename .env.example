# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call the API (your deployed site URL, no trailing slash)
CLIENT_ORIGIN=http://localhost:5500

# PostgreSQL — get this from your host (Render/Railway/Supabase/etc.)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/arss_entertainment
# Most managed Postgres hosts require SSL — leave true unless running Postgres locally
DB_SSL=true

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=arss_admin_token

# Cloudinary — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# First admin account, created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_before_seeding
